@model List<a_job_finder.Models.Job>
@using a_job_finder.Helpers

@{
    ViewData["Title"] = "Find Entry Level Jobs";
}

<div class="hero-section">
    <h1 class="hero-title">Launch Your Career</h1>
    <p class="hero-subtitle">Discover curated entry-level roles requiring 0-2 years of experience. Hand-picked for junior developers.</p>
    
    <form method="get" asp-action="Index" class="max-w-xl mx-auto mt-4" style="max-width: 600px; margin: 0 auto;">
        <div class="input-group mb-3 glass-card p-2" style="border-radius: 16px;">
            <input type="text" name="search" value="@ViewBag.Search" class="form-control search-bar border-0 bg-transparent" placeholder="Search junior react, backend, design..." />
            <button class="apply-btn ms-2" type="submit">Search</button>
        </div>
        <div class="form-check form-switch d-flex justify-content-center align-items-center gap-2 mt-3">
            <input class="form-check-input" type="checkbox" id="entryLevelFilter" name="entryLevelOnly" value="true" @(ViewBag.EntryLevelOnly ? "checked" : "") onchange="this.form.submit()">
            <label class="form-check-label" for="entryLevelFilter">Show only Entry-Level & Junior roles (0-2 YOE)</label>
        </div>
    </form>
</div>

<div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4 mt-2">
    @if(Model != null && Model.Any())
    {
        @foreach(var job in Model)
        {
            <div class="col">
                <div class="glass-card d-flex flex-column">
                    <div class="d-flex justify-content-between align-items-start mb-2">
                        @if(!string.IsNullOrEmpty(job.JobType))
                        {
                            <span class="job-type-badge">@job.JobType</span>
                        }
                        @if(!string.IsNullOrEmpty(job.JobLevel))
                        {
                            <span class="job-level-badge">@job.JobLevel</span>
                        }
                        else
                        {
                            <span class="job-level-badge">Entry Level</span>
                        }
                    </div>
                    
                    <h3 class="job-title">@job.JobTitle</h3>
                    <div class="company-name">@job.CompanyName &nbsp;•&nbsp; @job.JobGeo</div>
                    
                    <p class="job-excerpt flex-grow-1">
                        @StringHelper.BreakLongText(job.JobExcerpt, 120)
                    </p>
                    
                    <div class="mt-3">
                        <a href="@job.Url" target="_blank" class="apply-btn w-100 text-center">Apply Now</a>
                    </div>
                </div>
            </div>
        }
    }
    else
    {
        <div class="col-12 text-center mt-5">
            <h4 class="text-muted">No jobs found matching your criteria.</h4>
            <p class="text-secondary">Try adjusting your search terms or filters.</p>
        </div>
    }
</div>
